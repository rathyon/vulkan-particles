#version 450

#extension GL_EXT_scalar_block_layout: enable
#extension GL_EXT_buffer_reference : require

struct Particle
{
    vec4 Position;
    vec4 Color; // constant
    float Radius; // constant
    float Theta;
    float AngularVelocity; // constant
};

layout (scalar, binding = 0) readonly buffer ParticlesSSBOIn {
    Particle ParticlesIn[];
};

layout (scalar, binding = 1) buffer ParticlesSSBOOut {
    Particle ParticlesOut[];
};

struct WorldData
{
    float Time;
    float DeltaTime;
    uint ParticleCount;
};

layout (buffer_reference, std430, buffer_reference_align = 4) buffer WorldDataUBORef
{
    WorldData WorldDataUBO;
};

layout (push_constant) uniform PushConstants
{
    WorldDataUBORef WorldDataRef;
} PushConstant;

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main() {
    // Current SSBO index
    uint index = gl_GlobalInvocationID.x;

    const WorldData world_data = PushConstant.WorldDataRef.WorldDataUBO;

    // Don't try to write beyond particle count
    if (index >= (world_data.ParticleCount)) {
        return;
    }

    float delta_theta = ParticlesIn[index].AngularVelocity * world_data.DeltaTime;
    float new_theta = ParticlesIn[index].Theta + delta_theta;

    ParticlesOut[index].Theta = new_theta;

    // Update position
    ParticlesOut[index].Position.xyz = vec3(cos(new_theta) * ParticlesIn[index].Radius, ParticlesIn[index].Position.y, sin(new_theta) * ParticlesIn[index].Radius);

    ParticlesOut[index].Color = ParticlesIn[index].Color;
    ParticlesOut[index].Radius = ParticlesIn[index].Radius;
    ParticlesOut[index].AngularVelocity = ParticlesIn[index].AngularVelocity;
}
