#version 450

struct Particle
{
    vec4 Position;
    vec4 Velocity;
    vec4 Color;
};

struct WorldData {
    float DeltaTime;
    uint ParticleCount;
};

layout (std430, binding = 0) readonly buffer ParticlesSSBOIn {
    Particle ParticlesIn[];
};

layout (std430, binding = 1) buffer ParticlesSSBOOut {
    Particle ParticlesOut[];
};

layout (std140, binding = 2) uniform WorldDataBlock {
    float DeltaTime;
    uint ParticleCount;
} WorldDataUBO;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main() {
    // Current SSBO index
    uint index = gl_GlobalInvocationID.x;

    // Don't try to write beyond particle count
    if(index >= (WorldDataUBO.ParticleCount)) {
        return;
    }

    ParticlesOut[index] = ParticlesIn[index];
}
